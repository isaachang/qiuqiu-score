/* ---------- 玻璃底板 ---------- */
.tb{position:fixed;left:40rpx;right:40rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));height:128rpx;border-radius:64rpx;padding:10rpx;box-sizing:border-box;display:flex;z-index:100;
  background:linear-gradient(135deg,rgba(255,255,255,.44),rgba(255,255,255,.16));
  -webkit-backdrop-filter:blur(14px) saturate(200%) brightness(1.06);backdrop-filter:blur(14px) saturate(200%) brightness(1.06);
  box-shadow:inset 0 2rpx 0 rgba(255,255,255,.95),inset 0 -2rpx 0 rgba(255,255,255,.4),inset 0 0 0 1rpx rgba(255,255,255,.6),0 26rpx 60rpx -22rpx rgba(40,30,20,.38),0 2rpx 8rpx rgba(40,30,20,.06);
  transition:left .55s cubic-bezier(.3,1.25,.5,1),right .55s cubic-bezier(.3,1.25,.5,1),height .45s cubic-bezier(.3,1.25,.5,1),border-radius .45s,padding .45s}
/* 玻璃的镜面高光（左上亮）与底部反光 */
.tb::before{content:"";position:absolute;top:0;left:0;right:0;bottom:0;border-radius:inherit;pointer-events:none;
  background:radial-gradient(120% 100% at 18% 0%,rgba(255,255,255,.42),rgba(255,255,255,0) 55%)}
.tb::after{content:"";position:absolute;left:12%;right:12%;bottom:2rpx;height:2rpx;border-radius:2rpx;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent)}
.tb.lite{background:rgba(255,255,255,.96);-webkit-backdrop-filter:none;backdrop-filter:none}

/* ---------- 玻璃透镜（选中项） ---------- */
.lens{position:absolute;top:10rpx;bottom:10rpx;left:10rpx;width:calc((100% - 20rpx) / 3);z-index:1;transition:transform .6s cubic-bezier(.3,1.3,.5,1)}
.lens.na{transition:none}
.lq{position:absolute;top:0;left:0;right:0;bottom:0;border-radius:56rpx;
  background:linear-gradient(160deg,rgba(255,255,255,.86),rgba(255,255,255,.42));
  box-shadow:inset 0 2rpx 0 #fff,inset 0 -8rpx 14rpx rgba(255,255,255,.5),inset 0 0 0 1rpx rgba(255,255,255,.95),0 12rpx 26rpx -12rpx rgba(255,90,95,.5),0 2rpx 6rpx rgba(0,0,0,.06);
  transition:transform .3s cubic-bezier(.3,1.4,.5,1)}
/* 移动时像液体一样先拉长再回弹（两个同样的动画交替，保证每次都能重新播放） */
.lq.s1{animation:liquid1 .62s cubic-bezier(.3,1,.5,1)}
.lq.s2{animation:liquid2 .62s cubic-bezier(.3,1,.5,1)}
.lq.s0{animation:none}
@keyframes liquid1{0%{transform:none}30%{transform:scaleX(1.3) scaleY(.86)}62%{transform:scaleX(.95) scaleY(1.05)}100%{transform:none}}
@keyframes liquid2{0%{transform:none}30%{transform:scaleX(1.3) scaleY(.86)}62%{transform:scaleX(.95) scaleY(1.05)}100%{transform:none}}
/* 按住透镜：微微放大，像要被拿起来 */
.lq.pr{transform:scale(1.07)}

/* ---------- 图标与文字 ---------- */
.ti{flex:1;position:relative;z-index:2;display:flex;align-items:center;justify-content:center;gap:10rpx;color:#6B6B73;font-size:26rpx;font-weight:700;transition:color .3s}
.ti.on{color:#FF5A5F;font-weight:800}
.ic{width:44rpx;height:44rpx;transition:transform .45s cubic-bezier(.3,1.5,.5,1)}
.ti.on .ic{transform:scale(1.08)}
.tx{overflow:hidden;white-space:nowrap;max-width:80rpx;transition:max-width .4s,opacity .25s}

/* ---------- 往下滚动：收小成只有图标的小胶囊 ---------- */
.tb.mini{left:200rpx;right:200rpx;height:100rpx;border-radius:50rpx;padding:8rpx}
.tb.mini .lens{top:8rpx;bottom:8rpx;left:8rpx;width:calc((100% - 16rpx) / 3)}
.tb.mini .lq{border-radius:44rpx}
.tb.mini .tx{max-width:0;opacity:0}
.tb.mini .ti{gap:0}
.tb.mini .ic{width:40rpx;height:40rpx}

/* 性能：底板和透镜各自独立成一层，由 GPU 合成；页面忙的时候透镜照样顺滑滑动 */
.tb{transform:translateZ(0)}
.lens{will-change:transform;transform-origin:center}
.lq{will-change:transform;backface-visibility:hidden}
/* 按下：图标轻轻下沉（用 hover-class，不额外触发数据更新） */
.tip .ic{transform:scale(.88)}

/* 页面弹出面板时，Tab 滑出屏幕，避免挡住面板按钮 */
.tb{transition:left .55s cubic-bezier(.3,1.25,.5,1),right .55s cubic-bezier(.3,1.25,.5,1),height .45s cubic-bezier(.3,1.25,.5,1),border-radius .45s,padding .45s,transform .4s cubic-bezier(.3,1.1,.5,1),opacity .3s}
.tb.hide{transform:translateY(220%);opacity:0;pointer-events:none}
