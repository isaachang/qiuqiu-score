.tu{z-index:91}
.tu-t{text-align:center;font-size:40rpx;font-weight:900;margin-top:8rpx}
.tu-d{text-align:center;font-size:26rpx;color:var(--tx2);margin-top:8rpx}
.tu-end{margin-top:36rpx}
.tu-sec{font-size:24rpx;font-weight:700;color:var(--tx3);margin:36rpx 0 16rpx 8rpx}
.tu-row{display:flex;gap:14rpx}
.tu-o{flex:1;min-width:0;white-space:nowrap;height:92rpx;border-radius:28rpx;background:var(--card2);display:flex;align-items:center;justify-content:center;font-size:27rpx;font-weight:800;color:var(--tx)}
.tu-cancel{text-align:center;color:var(--tx2);font-size:30rpx;font-weight:600;padding:32rpx 0 4rpx}
.tu-face.off{display:none}
.tu-wf{animation:tuIn .32s cubic-bezier(.2,1,.3,1)}
@keyframes tuIn{from{opacity:0;transform:translateX(40rpx)}}
/* 滚轮（同新对局的自定义时长） */
.pvw{position:relative;margin:20rpx 0 8rpx}
.pv{height:440rpx;width:100%}
.pvc{height:88rpx;line-height:88rpx;text-align:center;font-size:44rpx;font-weight:700;padding-right:96rpx;box-sizing:border-box}
.pvi{height:88rpx;background:rgba(20,20,30,.06);border-radius:24rpx}
.pvi::before,.pvi::after{display:none}
.pvl{position:absolute;top:50%;transform:translateY(-50%);font-size:28rpx;font-weight:600;color:var(--tx2);pointer-events:none}
.pvl.l1{left:calc(25% + 10rpx)}.pvl.l2{left:calc(75% + 10rpx)}

/* 横屏：rpx 会被放大，改用 px；面板居中、不铺满 */
.tu.land{left:calc(50% - 220px);right:calc(50% - 220px);bottom:8px;border-radius:28px;padding:8px 20px 14px}
.tu.land .grab{margin:2px auto 6px}
.tu.land .tu-t{font-size:19px;margin-top:0}
.tu.land .tu-d{font-size:12px;margin-top:2px}
.tu.land .tu-end{margin-top:12px;height:44px;font-size:15px;border-radius:16px}
.tu.land .tu-sec{font-size:11px;margin:12px 0 6px 4px}
.tu.land .tu-row{gap:8px}
.tu.land .tu-o{height:40px;border-radius:14px;font-size:13px}
.tu.land .tu-cancel{font-size:14px;padding:10px 0 0}
.tu.land .pvw{margin:6px 0 2px}
.tu.land .pv{height:150px}
.tu.land .pvc{height:38px;line-height:38px;font-size:20px;padding-right:44px}
.tu.land .pvi{height:38px;border-radius:12px}
.tu.land .pvl{font-size:13px}
.tu.land .pvl.l1{left:calc(25% + 4px)}.tu.land .pvl.l2{left:calc(75% + 4px)}
