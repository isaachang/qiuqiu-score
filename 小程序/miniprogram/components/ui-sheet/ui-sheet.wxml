<view class="sheet-mask {{show?'on':''}}" bindtap="close" catchtouchmove="noop"></view>
<view class="sheet us {{show?'on':''}}" catchtap="noop" catchtouchmove="noop">
  <view class="grab"></view>
  <view wx:if="{{icon}}" class="usi {{icon}} {{show?'in':''}}">{{icon==='warn'?'!':'✓'}}</view>
  <view class="ust">{{title}}</view>
  <view wx:if="{{desc}}" class="usd">{{desc}}</view>
  <view class="usa">
    <view wx:for="{{actions}}" wx:key="k" class="ub {{item.type||'plain'}} {{show?'in':''}}" style="--i:{{index}}" data-k="{{item.k}}" bindtap="act" hover-class="ubp">{{item.t}}</view>
  </view>
  <view class="ucancel" bindtap="close">取消</view>
</view>
