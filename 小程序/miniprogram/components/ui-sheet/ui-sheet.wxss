.us{z-index:90}
.usi{width:104rpx;height:104rpx;border-radius:50%;margin:8rpx auto 20rpx;display:flex;align-items:center;justify-content:center;font-size:56rpx;font-weight:900;transform:scale(.4)}
.usi.in{animation:usiIn .5s cubic-bezier(.3,1.6,.5,1) .12s forwards}
@keyframes usiIn{to{transform:none}}
.usi.warn{background:#FF5A5F1F;color:#F0444D}
.usi.ok{background:#1FC98E1F;color:#0E9F5E}
.ust{text-align:center;font-size:36rpx;font-weight:900}
.usd{text-align:center;font-size:26rpx;color:#6B6B73;margin-top:10rpx;line-height:1.55;padding:0 12rpx}
.usa{display:flex;flex-direction:column;gap:16rpx;margin-top:36rpx}
.ub{height:104rpx;border-radius:36rpx;display:flex;align-items:center;justify-content:center;font-size:31rpx;font-weight:800;opacity:0;transform:translateY(24rpx)}
.ub.in{animation:ubIn .45s cubic-bezier(.2,1.1,.3,1) forwards;animation-delay:calc(var(--i) * 60ms + 120ms)}
@keyframes ubIn{to{opacity:1;transform:none}}
.ub.pri{background:#16161A;color:#fff}
.ub.danger{background:#F0444D;color:#fff}
.ub.plain{background:#F0EEE9;color:#16161A}
.ub.soft-danger{background:#F0EEE9;color:#E5383B}
.ubp{transform:scale(.96)!important;opacity:.9!important}
.ucancel{text-align:center;color:#6B6B73;font-size:30rpx;font-weight:600;padding:28rpx 0 4rpx}
