/* 对局卡片 */
.mc{background:#fff;border-radius:44rpx;padding:24rpx 28rpx 28rpx}
.mt{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.mtg{display:flex;align-items:center;gap:10rpx;min-width:0;font-size:23rpx;font-weight:800;color:var(--tx2);white-space:nowrap;overflow:hidden}
.tdot{width:16rpx;height:16rpx;border-radius:50%;flex:none}
.tg{color:var(--tx);flex:none}
.ti{overflow:hidden;text-overflow:ellipsis}
.when{flex:none;font-size:23rpx;color:var(--tx3);font-weight:700}
.vs2{display:flex;align-items:center;margin-top:20rpx}
.pp{width:176rpx;flex:none;display:flex;flex-direction:column;align-items:center;gap:10rpx;transition:opacity .2s}
.avw{position:relative}
.av.ma{width:92rpx;height:92rpx;font-size:36rpx}
.pn{font-size:25rpx;font-weight:800;max-width:170rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pp.lose .av{opacity:.5;filter:saturate(.55)}
.pp.lose .pn{color:var(--tx2);font-weight:700}
/* 「胜」字章：贴在头像右上角，稍微倾斜 */
.won{position:absolute;top:-14rpx;right:-22rpx;font-size:22rpx;font-weight:900;padding:2rpx 12rpx;border-radius:16rpx;transform:rotate(12deg);box-shadow:0 0 0 4rpx #fff,0 10rpx 20rpx -8rpx rgba(0,0,0,.4)}
.mid{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center}
.big{font-size:80rpx;font-weight:900;line-height:1;letter-spacing:-.01em}
.big .w{color:var(--tx)}
.big .l{color:var(--tx3)}
.co{font-size:52rpx;color:var(--tx3);margin:0 14rpx;vertical-align:8rpx}
.netv{font-size:58rpx;font-weight:900;line-height:1}
.co2{font-size:40rpx;color:var(--tx3);margin:0 12rpx;vertical-align:6rpx}
.netv .pos,.ts.pos{color:var(--pos)}
.netv .neg,.ts.neg{color:var(--neg)}
.cmp2{display:flex;align-items:stretch;height:46rpx;margin-top:18rpx;border-radius:23rpx;overflow:hidden}
.cv{display:flex;align-items:center;justify-content:center;min-width:64rpx;padding:0 18rpx;font-size:23rpx;font-weight:900}
.cl{display:flex;align-items:center;padding:0 18rpx;background:#F0EEE9;color:var(--tx2);font-size:22rpx;font-weight:800;white-space:nowrap}
.note{font-size:21rpx;color:var(--tx2);font-weight:700;margin-top:14rpx}
.tri{display:grid;grid-template-columns:repeat(3,1fr);margin-top:20rpx}
.tri .pp{width:auto}
.ts{font-size:48rpx;font-weight:900;line-height:1;margin-top:4rpx}
