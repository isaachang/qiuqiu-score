/* 背景：把首页虚化 + 提亮，卡片浮在中间 */
.wm{position:fixed;top:0;left:0;right:0;bottom:0;z-index:120;display:flex;align-items:center;justify-content:center;
  background:rgba(246,244,240,.42);-webkit-backdrop-filter:blur(22px) saturate(170%);backdrop-filter:blur(22px) saturate(170%);animation:wmIn .4s ease both}
.wm.lite{background:rgba(246,244,240,.96);-webkit-backdrop-filter:none;backdrop-filter:none}
.wm.out{animation:wmOut .32s ease forwards}
@keyframes wmIn{from{opacity:0}}
@keyframes wmOut{to{opacity:0}}
.wc{width:654rpx;background:var(--card);border-radius:64rpx;padding:24rpx 0 28rpx;box-shadow:0 60rpx 120rpx -40rpx rgba(40,30,20,.45),0 0 0 1rpx rgba(20,20,30,.04);animation:wcIn .62s cubic-bezier(.25,1.35,.4,1) both .05s}
.wm.out .wc{animation:wcOut .32s ease forwards}
@keyframes wcIn{from{opacity:0;transform:translateY(60rpx) scale(.92)}}
@keyframes wcOut{to{opacity:0;transform:scale(.94)}}

.ws{height:760rpx}
.pg{height:100%;display:flex;flex-direction:column;align-items:center;padding:0 48rpx;box-sizing:border-box}
.ill{width:100%;height:420rpx;position:relative;display:flex;align-items:center;justify-content:center;margin-bottom:28rpx}
.wt{font-size:44rpx;font-weight:900;text-align:center;letter-spacing:-.01em}
.wd{font-size:27rpx;line-height:1.65;color:var(--tx2);text-align:center;margin-top:14rpx}
/* 进入当前页时，插图和文字依次浮现 */
.pg .ill,.pg .wt,.pg .wd,.pg .win{opacity:0;transform:translateY(24rpx)}
.pg.on .ill,.pg.on .wt,.pg.on .wd,.pg.on .win{animation:up .55s cubic-bezier(.2,1.1,.3,1) forwards}
.pg.on .wt{animation-delay:.08s}.pg.on .wd{animation-delay:.14s}.pg.on .win{animation-delay:.2s}
@keyframes up{to{opacity:1;transform:none}}

/* 1. logo + 三颗球 */
.glow{position:absolute;width:300rpx;height:300rpx;border-radius:50%;background:radial-gradient(circle,#FFC53D55,transparent 70%)}
.logo{width:200rpx;height:200rpx;border-radius:56rpx;box-shadow:0 30rpx 60rpx -24rpx rgba(255,90,95,.55);position:relative;z-index:2}
.bl{position:absolute;border-radius:50%;box-shadow:0 16rpx 24rpx -10rpx rgba(0,0,0,.35);z-index:3}
.b-r{width:92rpx;height:92rpx;left:96rpx;top:70rpx;background:radial-gradient(circle at 34% 28%,rgba(255,255,255,.85) 0 8%,transparent 22%),radial-gradient(circle at 60% 72%,transparent 40%,rgba(0,0,0,.35) 100%),#FF5A5F}
.b-b{width:76rpx;height:76rpx;right:92rpx;top:96rpx;background:radial-gradient(circle at 34% 28%,rgba(255,255,255,.85) 0 8%,transparent 22%),radial-gradient(circle at 60% 72%,transparent 40%,rgba(0,0,0,.35) 100%),#3D7BFF}
.b-9{width:84rpx;height:84rpx;right:130rpx;bottom:52rpx;background:radial-gradient(circle at 34% 28%,rgba(255,255,255,.9) 0 8%,transparent 22%),radial-gradient(circle at 60% 72%,transparent 40%,rgba(0,0,0,.3) 100%),linear-gradient(180deg,#fff 0 26%,#FFC21A 26% 74%,#fff 74%)}
.pg.on .b-r{animation:pop .7s cubic-bezier(.3,1.6,.5,1) .2s both,bob 4s ease-in-out 1s infinite}
.pg.on .b-b{animation:pop .7s cubic-bezier(.3,1.6,.5,1) .3s both,bob 4.6s ease-in-out 1.2s infinite}
.pg.on .b-9{animation:pop .7s cubic-bezier(.3,1.6,.5,1) .4s both,bob 5s ease-in-out 1.4s infinite}
@keyframes pop{from{opacity:0;transform:scale(.2)}}
@keyframes bob{50%{transform:translateY(-14rpx) rotate(10deg)}}

/* 2. 迷你记分卡：手指点一下 → +4 飘起 */
.mc{width:420rpx;border-radius:44rpx;background:#FF5A5F;color:#fff;padding:28rpx 28rpx 24rpx;position:relative;box-shadow:0 30rpx 60rpx -26rpx rgba(255,90,95,.7);overflow:hidden}
.mh{display:flex;align-items:center;gap:14rpx}
.ma{width:56rpx;height:56rpx;border-radius:50%;background:#fff;color:#FF5A5F;font-weight:900;font-size:26rpx;display:flex;align-items:center;justify-content:center}
.mn{font-size:28rpx;font-weight:800;max-width:260rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.ms{display:block;text-align:center;font-size:96rpx;font-weight:900;line-height:1.1;margin:10rpx 0 18rpx}
.mchips{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx}
.mk{height:52rpx;border-radius:16rpx;background:rgba(255,255,255,.24);font-size:20rpx;font-weight:800;display:flex;align-items:center;justify-content:center}
.tap{position:absolute;left:50%;top:120rpx;width:90rpx;height:90rpx;margin-left:-45rpx;border-radius:50%;background:rgba(255,255,255,.6);opacity:0}
.pg.on .tap{animation:tap 2.4s ease-out .5s infinite}
@keyframes tap{0%{opacity:0;transform:scale(.4)}12%{opacity:.9;transform:scale(.6)}40%{opacity:0;transform:scale(1.6)}100%{opacity:0}}
.pg.on .mc{animation:press 2.4s ease .5s infinite}
@keyframes press{0%,8%,30%,100%{transform:none}14%{transform:scale(.96)}}
.fl{position:absolute;right:96rpx;top:40rpx;font-size:44rpx;font-weight:900;color:#13B57A;opacity:0}
.pg.on .fl{animation:fly 2.4s ease-out .6s infinite}
@keyframes fly{0%,8%{opacity:0;transform:translateY(30rpx)}20%{opacity:1}55%{opacity:0;transform:translateY(-50rpx)}100%{opacity:0}}

/* 3. 迷你战绩：柱子依次长高 */
.rc{width:440rpx;border-radius:44rpx;background:var(--card2);padding:30rpx 32rpx 28rpx}
.rh{display:flex;align-items:baseline;justify-content:space-between}
.rl{font-size:26rpx;font-weight:700;color:var(--tx2)}
.rv{font-size:64rpx;font-weight:900;color:#13B57A}
.bars{height:200rpx;display:flex;align-items:flex-end;gap:18rpx;margin-top:16rpx}
.bar{flex:1;height:var(--h);border-radius:14rpx 14rpx 8rpx 8rpx;background:linear-gradient(180deg,#3D7BFF,#7AA5FF);transform-origin:bottom;transform:scaleY(.05)}
.bar:nth-child(4),.bar:nth-child(6){background:linear-gradient(180deg,#FF5A5F,#FF8F92)}
.pg.on .bar{animation:grow .7s cubic-bezier(.3,1.4,.5,1) forwards;animation-delay:calc(var(--d) + .25s)}
@keyframes grow{to{transform:none}}

/* 4. 起名字 */
.nav-av{width:180rpx;height:180rpx;border-radius:50%;font-size:76rpx;font-weight:900;display:flex;align-items:center;justify-content:center;box-shadow:0 30rpx 60rpx -24rpx rgba(40,30,20,.45);transition:transform .3s}
.pg.on .nav-av{animation:pop .7s cubic-bezier(.3,1.6,.5,1) .15s both}
.win{width:100%;height:104rpx;margin-top:32rpx;border-radius:34rpx;background:var(--card2);padding:0 32rpx;box-sizing:border-box;display:flex;align-items:center;transition:box-shadow .2s,background .2s}
.win.fo{background:var(--card);box-shadow:inset 0 0 0 4rpx #16161A}
.wip{flex:1;height:104rpx;font-size:34rpx;font-weight:700;text-align:center}
.wph{color:var(--tx3);font-weight:500}

/* 底部 */
.dots{display:flex;justify-content:center;gap:12rpx;margin:8rpx 0 28rpx}
.dot{width:14rpx;height:14rpx;border-radius:7rpx;background:var(--tx3);opacity:.45;transition:width .35s cubic-bezier(.3,1.4,.5,1),opacity .3s,background .3s}
.dot.on{width:40rpx;opacity:1;background:var(--ink)}
.wb{margin:0 48rpx}
.skip{text-align:center;font-size:28rpx;font-weight:600;color:var(--tx2);padding:26rpx 0 4rpx;transition:opacity .25s}
.skip.hid{opacity:0;pointer-events:none}
.ill.i4{height:300rpx}
