/* 球球记分 · 记分页共用样式（竖屏 / 横屏） */
page{height:100%;overflow:hidden}
.screen{height:100vh;display:flex;flex-direction:column;overflow:hidden;position:relative}

/* 自定义导航栏（避让胶囊） */
.nav{flex:none;position:relative;display:flex;align-items:center}
.nav .bk{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;margin-left:8rpx}
.nav .bk image{width:44rpx;height:44rpx}
.nav .tt{position:absolute;left:0;right:0;top:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.nav .tt .t1{font-size:34rpx;font-weight:600}
.nav .tt .t2{font-size:22rpx;color:var(--tx2);font-variant-numeric:tabular-nums;pointer-events:auto;padding:2rpx 14rpx;border-radius:20rpx;transition:color .3s,background .3s}
/* 限时比赛：最后 5 分钟变红；超时后显示 +超出时间，淡红底，点它可再打开「时间到」 */
.t2.warn,.lt .t2.warn{color:#F0444D;font-weight:700}
.t2.over,.lt .t2.over{color:#F0444D;background:#FF5A5F1A;font-weight:700}

/* 数字滚轮 */
.odo{display:inline-flex;line-height:1;height:1em;overflow:hidden;font-weight:800;letter-spacing:-.03em}
.odo .sg{display:inline-block;overflow:hidden;width:0;transition:width .4s cubic-bezier(.3,1.4,.5,1)}
.odo .sg.on{width:.5em}
.odo .col{display:inline-block;height:1em;overflow:hidden}
.odo .strip{transition:transform .9s cubic-bezier(.2,.9,.25,1.06)}
.odo .dg{height:1em;line-height:1em;text-align:center}

/* 玩家卡片 */
.pc{position:relative;border-radius:60rpx;padding:28rpx;overflow:hidden;transition:transform .3s cubic-bezier(.3,1.4,.5,1)}
.pc-press{transform:scale(.985)}
.ph{display:flex;align-items:center;gap:20rpx;position:relative;z-index:2}
.ph .av{width:72rpx;height:72rpx;font-size:30rpx}
.pid{min-width:0;display:flex;flex-direction:column;gap:6rpx}
.nm{font-size:36rpx;font-weight:800;display:flex;align-items:center;gap:12rpx;white-space:nowrap}
.crown{width:32rpx;height:32rpx;animation:crIn .5s cubic-bezier(.3,1.4,.5,1)}
@keyframes crIn{from{transform:scale(0) rotate(-30deg)}}
.role{font-size:22rpx;font-weight:700;padding:4rpx 18rpx;border-radius:99rpx;background:rgba(255,255,255,.24)}
.role.brk{background:currentColor}
.role.brk text{filter:invert(1)}
.hint{align-self:flex-start;display:inline-flex;align-items:center;height:44rpx;padding:0 18rpx;border-radius:22rpx;font-size:22rpx;font-weight:700;background:rgba(255,255,255,.2);white-space:nowrap}
.hint.intro{animation:hintPulse 1.1s ease-in-out 2}
@keyframes hintPulse{50%{transform:scale(1.08);box-shadow:0 0 0 12rpx rgba(255,255,255,.18)}}
.ps{display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;z-index:2}
.lead{position:absolute;right:4rpx;top:12rpx;font-size:24rpx;font-weight:700;padding:8rpx 20rpx;border-radius:99rpx;background:rgba(255,255,255,.22)}
.chips{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx;position:relative;z-index:3}
.chip{border-radius:34rpx;background:#fff;color:#16161A;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;position:relative;box-shadow:0 8rpx 20rpx -12rpx rgba(0,0,0,.25);transition:transform .3s cubic-bezier(.3,1.4,.5,1)}
.chip-press{transform:scale(.88)}
.chip .cl{font-size:24rpx;font-weight:600;color:#8A8A92;display:flex;align-items:center;gap:6rpx;white-space:nowrap}
.chip .cv{font-size:38rpx;font-weight:800;line-height:1}
.chip .cnt{position:absolute;top:-10rpx;right:-6rpx;min-width:38rpx;height:38rpx;padding:0 10rpx;border-radius:19rpx;font-size:22rpx;font-weight:800;line-height:38rpx;text-align:center;background:#16161A;color:#fff}

/* 动效 */
.flash{position:absolute;top:0;left:0;right:0;bottom:0;border-radius:inherit;background:#fff;opacity:0;pointer-events:none;z-index:1}
.pc.hit .flash{animation:flash .55s ease-out}
@keyframes flash{0%{opacity:.45}100%{opacity:0}}
.sheen{position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:4;transform:translateX(-130%);background:linear-gradient(105deg,transparent 22%,rgba(255,236,150,.55) 40%,rgba(255,255,255,.95) 50%,rgba(255,236,150,.55) 60%,transparent 78%)}
.pc.gold .sheen{animation:sheen .9s ease-in-out 2}
.pc.gold .flash{background:#FFE27A;animation:flash .8s ease-out}
@keyframes sheen{to{transform:translateX(130%)}}
.pc.shake{animation:shake .45s}
@keyframes shake{20%{transform:translateX(-14rpx) rotate(-.6deg)}40%{transform:translateX(12rpx) rotate(.5deg)}60%{transform:translateX(-8rpx)}80%{transform:translateX(4rpx)}}
.fly{position:absolute;left:50%;top:30%;font-size:56rpx;font-weight:900;white-space:nowrap;z-index:9;pointer-events:none;animation:fly 1.1s cubic-bezier(.2,.8,.3,1) forwards;text-shadow:0 4rpx 20rpx rgba(0,0,0,.18)}
.fly.dim{opacity:.8}
@keyframes fly{0%{transform:translate(-50%,0) scale(.5);opacity:0}15%{opacity:1;transform:translate(-50%,-24rpx) scale(1.2)}100%{transform:translate(-50%,-150rpx) scale(1);opacity:0}}
.banner{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;z-index:60;pointer-events:none}
.bx{background:#fff;border-radius:68rpx;padding:44rpx 76rpx 40rpx;display:flex;flex-direction:column;align-items:center;gap:8rpx;box-shadow:0 60rpx 120rpx -40rpx rgba(0,0,0,.45);animation:pop 1.7s cubic-bezier(.2,1.3,.3,1) forwards}
@keyframes pop{0%{transform:scale(.4) rotate(-6deg);opacity:0}16%{transform:scale(1.06);opacity:1}28%{transform:scale(1)}80%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.1)}}
.bx .bi{width:128rpx;height:128rpx;animation:spinIn 1.2s cubic-bezier(.2,.8,.3,1)}
.bx .b9n{width:128rpx;height:128rpx;border-radius:50%;background:linear-gradient(180deg,#fff 0 26%,#FFC21A 26% 74%,#fff 74%);display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 2rpx rgba(0,0,0,.12);animation:spinIn 1.2s cubic-bezier(.2,.8,.3,1)}
.bx .b9n text{width:56rpx;height:56rpx;border-radius:50%;background:#fff;font-size:34rpx;font-weight:900;display:flex;align-items:center;justify-content:center}
@keyframes spinIn{from{transform:rotate(-400deg) scale(.3)}}
.bx .bt{font-size:84rpx;font-weight:900;letter-spacing:8rpx}
.bx .bs{font-size:28rpx;font-weight:700;color:#6B6B73}

/* 底栏 */
.dock{position:fixed;left:16rpx;right:16rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));height:128rpx;border-radius:48rpx;background:#fff;box-shadow:0 20rpx 60rpx -20rpx rgba(0,0,0,.25);display:flex;align-items:center;justify-content:space-around;z-index:20}
.dock .db{width:150rpx;height:108rpx;border-radius:36rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;font-size:22rpx;font-weight:600;color:#6B6B73}
.dock .db image{width:44rpx;height:44rpx}
.dock .db.hl{color:#16161A}
.dock .db.end{color:#FF5A5F}
.dbp{background:rgba(0,0,0,.05);transform:scale(.92)}

/* 金球彩纸 */
.pt{position:absolute;left:50%;top:45%;border-radius:3px;z-index:8;pointer-events:none;animation:pt 1s cubic-bezier(.15,.7,.3,1) forwards}
@keyframes pt{0%{transform:translate(0,0) rotate(0) scale(1);opacity:1}100%{transform:translate(var(--dx),var(--dy)) rotate(360deg) scale(.2);opacity:0}}

/* 金球庆祝：大金 / 小金 / 黄金九 统一的奖章样式 */
.medal{width:148rpx;height:148rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;animation:spinIn 1.1s cubic-bezier(.2,.8,.3,1)}
.medal .mg{width:84rpx;height:84rpx}
.medal .m9{width:84rpx;height:84rpx;border-radius:50%;background:#fff;color:#16161A;font-size:52rpx;font-weight:900;display:flex;align-items:center;justify-content:center}

/* 庆祝弹窗固定尺寸：大金 / 小金 / 黄金九 完全一致，不随说明文字长短变化 */
.bx{width:500rpx;min-height:420rpx;box-sizing:border-box;padding-left:36rpx;padding-right:36rpx;justify-content:center}
.bx .bs{text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}

/* 底栏从下方弹入 */
.ent .dockin{animation:dockIn .6s cubic-bezier(.2,1.2,.3,1) .25s backwards}
@keyframes dockIn{from{transform:translateY(160%)}}
/* 金球庆祝：背后内容虚化，突出庆祝弹窗 */
.banner{background:rgba(246,244,240,.18);-webkit-backdrop-filter:blur(10px) saturate(140%);backdrop-filter:blur(10px) saturate(140%);animation:bgIn 1.7s ease forwards}
@keyframes bgIn{0%{opacity:0}12%{opacity:1}82%{opacity:1}100%{opacity:0}}
/* 首次使用引导 */
.coach{position:fixed;top:0;left:0;right:0;bottom:0;z-index:80;background:rgba(10,10,20,.55);animation:fadeIn .3s ease}
.cf{position:relative;z-index:81;box-shadow:0 0 0 8rpx rgba(255,255,255,.9),0 0 0 9999rpx rgba(10,10,20,0)}
.dock.cf{z-index:81}
.cb{position:fixed;left:40rpx;right:40rpx;z-index:82;background:#fff;border-radius:40rpx;padding:32rpx 36rpx;box-shadow:0 30rpx 60rpx -20rpx rgba(0,0,0,.5);animation:popIn .45s cubic-bezier(.3,1.4,.5,1)}
.cbs{font-size:22rpx;font-weight:800;color:#FF5A5F}
.cbt{display:block;font-size:36rpx;font-weight:900;margin-top:6rpx}
.cbd{display:block;font-size:26rpx;color:#6B6B73;margin-top:8rpx;line-height:1.5}
.cbn{margin-top:24rpx;align-self:flex-end;display:inline-flex;height:72rpx;padding:0 36rpx;border-radius:36rpx;background:#16161A;color:#fff;font-size:26rpx;font-weight:800;align-items:center;float:right}

/* 金球庆祝 v3：入场后常驻；有音乐时一直显示到音乐结束，点任意处关闭（音乐一起停） */
.banner{pointer-events:auto;animation:bannerIn .3s ease forwards}
.banner.out{animation:bannerOut .3s ease forwards}
@keyframes bannerIn{from{opacity:0}to{opacity:1}}
@keyframes bannerOut{from{opacity:1}to{opacity:0}}
.bx{animation:bxIn .65s cubic-bezier(.2,1.3,.3,1) forwards}
.banner.out .bx{animation:bxOut .3s ease forwards}
@keyframes bxIn{0%{transform:scale(.4) rotate(-6deg);opacity:0}60%{transform:scale(1.06);opacity:1}100%{transform:none;opacity:1}}
@keyframes bxOut{to{transform:scale(1.08);opacity:0}}
.banner.live .medal{animation:spinIn 1.1s cubic-bezier(.2,.8,.3,1),beat 1.05s ease-in-out 1.1s infinite}
@keyframes beat{50%{transform:scale(1.1)}}
.banner.live .bt{animation:glow 1.6s ease-in-out infinite}
@keyframes glow{50%{text-shadow:0 0 24rpx currentColor}}
.btap{margin-top:14rpx;font-size:22rpx;color:#A9A9B0;font-weight:600}  /* 和弹窗一起出现，不再延迟 */

/* 记分底栏：液态玻璃（覆盖原来的纯白底） */
.dock.glass{border-radius:48rpx;background:linear-gradient(135deg,rgba(255,255,255,.44),rgba(255,255,255,.16));-webkit-backdrop-filter:blur(14px) saturate(200%) brightness(1.06);backdrop-filter:blur(14px) saturate(200%) brightness(1.06);box-shadow:inset 0 2rpx 0 rgba(255,255,255,.95),inset 0 -2rpx 0 rgba(255,255,255,.4),inset 0 0 0 1rpx rgba(255,255,255,.6),0 24rpx 56rpx -22rpx rgba(40,30,20,.36),0 2rpx 8rpx rgba(40,30,20,.06)}
.dock.glass.lite{background:rgba(255,255,255,.96);-webkit-backdrop-filter:none;backdrop-filter:none}
.dock.glass .db{color:#4A4A52}

/* 犯规弹窗：红色奖章 + 感叹号，和黄金九同一套样式 */
.medal .mx{color:#fff;font-size:92rpx;font-weight:900;line-height:1}
.banner .bx .medal{transform-origin:center}

/* 名字牌：白底 + 球员颜色的大字（替代小头像），放远也认得出 */
.nmp{display:inline-block;font-size:46rpx;font-weight:900;line-height:1.15;padding:8rpx 26rpx;border-radius:999rpx;max-width:400rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-shadow:0 10rpx 22rpx -12rpx rgba(0,0,0,.4)}
/* 暂停浮层 */
.pzov{position:fixed;top:0;left:0;right:0;bottom:0;z-index:75;display:flex;align-items:center;justify-content:center;background:rgba(246,244,240,.4);-webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%);animation:pzIn .25s ease}
@keyframes pzIn{from{opacity:0}}
.pzbx{width:520rpx;background:#fff;border-radius:64rpx;padding:52rpx 44rpx 40rpx;display:flex;flex-direction:column;align-items:center;box-shadow:0 60rpx 120rpx -40rpx rgba(0,0,0,.45);animation:pzPop .5s cubic-bezier(.3,1.4,.5,1)}
@keyframes pzPop{from{transform:scale(.8);opacity:0}}
.pzic{width:112rpx;height:112rpx;border-radius:50%;background:var(--ink);display:flex;align-items:center;justify-content:center;gap:16rpx}
.pzb{width:16rpx;height:48rpx;border-radius:8rpx;background:#fff}
.pzt{font-size:48rpx;font-weight:900;margin-top:24rpx}
.pzc{font-size:40rpx;font-weight:800;color:var(--tx2);margin-top:6rpx}
.pzs{font-size:23rpx;color:var(--tx3);margin-top:10rpx}
.pzbtn{width:100%;margin-top:36rpx}
