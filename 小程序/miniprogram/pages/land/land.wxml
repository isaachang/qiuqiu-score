<import src="/templates/odo.wxml"/>
<view class="screen {{ent?'ent':'pre'}}">
  <view class="ltop" style="height:{{bar.H}}px">
    <!-- 左：竖屏 | 撤销（分段胶囊）；右：结算（紧挨微信胶囊） -->
    <view class="lseg glass {{lite?'lite':''}}" style="left:{{bar.l}}px;top:{{bar.bt}}px;height:{{bar.bh}}px">
      <view class="lsb" bindtap="back" hover-class="lsbp"><image src="/images/rotate-dark.svg"/>竖屏</view>
      <view class="lsd"></view>
      <view class="lsb" bindtap="onPause" hover-class="lsbp"><image src="/images/pause.svg"/>暂停</view>
      <view class="lsd"></view>
      <view class="lsb hl" bindtap="onUndo" hover-class="lsbp"><image src="/images/undo.svg"/>撤销</view>
    </view>
    <view class="lend glass {{lite?'lite':''}}" style="right:{{bar.capR}}px;top:{{bar.bt}}px;height:{{bar.bh}}px" bindtap="toFinish" hover-class="lsbp"><image src="/images/flag.svg"/>结算</view>
    <view class="lt" style="top:{{bar.bt}}px;height:{{bar.bh}}px"><text class="t1">第 {{round}} 局</text><text class="t2 num {{ccls}}" bindtap="onClock">{{ccls==='cd'||ccls==='warn'?'剩 ':''}}{{clock}}</text></view>
  </view>
  <view class="lcols {{n===3?'n3':'n2'}}" style="padding:12px {{bar.r}}px 14px {{bar.l}}px">
    <view wx:for="{{players}}" wx:key="id" class="pc lc {{risen?'':'rise'}} {{item.fx}}" style="--i:{{index}};background:{{item.c}};color:{{item.i}};{{item.mv}}">
      <view class="flash"></view><view class="sheen"></view>
      <view class="lmain" data-i="{{item.idx}}" bindtap="onCard" hover-class="tzp" hover-stay-time="60">
        <view class="ph">
          <view class="nm"><text class="nmp" style="background:{{item.i}};color:{{item.c}}">{{item.name}}</text><image wx:if="{{item.leader}}" class="crown" src="/images/crown.svg"/><text class="role" style="{{item.brk?'background:'+item.i+';color:'+item.c:''}}">{{item.role}}</text></view>
        </view>
        <view class="tz">
          <template is="odo" data="{{digits:item.digits,neg:item.neg}}"/>
          <view class="hint">轻点比分 · 普胜 +{{puV}}</view>
        </view>
      </view>
      <view class="lbtns" catchtap="noop">
        <view class="chip" wx:for="{{chips}}" wx:for-item="c" wx:for-index="ci" wx:key="k" data-i="{{item.idx}}" data-k="{{c.k}}" catchtap="onChip" hover-class="chip-press">
          <text class="cl">{{c.name}}</text><text class="cv num" style="color:{{c.t}}">{{c.v}}</text>
          <text wx:if="{{item.cnt[c.k]>0}}" class="cnt num">{{item.cnt[c.k]}}</text>
        </view>
      </view>
      <view wx:for="{{flies}}" wx:for-item="f" wx:for-index="fi" wx:key="id" wx:if="{{f.pi===item.idx}}" class="fly {{f.cls}}">{{f.text}}</view>
        <view wx:for="{{parts}}" wx:for-item="pt" wx:for-index="pti" wx:key="id" wx:if="{{pt.pi===item.idx}}" class="pt" style="{{pt.style}}"></view>
    </view>
  </view>
  <view wx:if="{{banner}}" class="banner {{banner.out?'out':''}} {{banner.live?'live':''}}" catchtap="onBannerTap" catchtouchmove="noop">
    <view class="bx">
      <view class="medal" style="background:{{banner.c}};box-shadow:0 0 0 10rpx {{banner.c}}33,0 18rpx 40rpx -12rpx {{banner.c}}">
        <image wx:if="{{banner.k==='dj'}}" class="mg" src="/images/crown-w.svg"/>
        <image wx:elif="{{banner.k==='xj'}}" class="mg" src="/images/spark-w.svg"/>
        <text wx:elif="{{banner.k==='foul'}}" class="mx">!</text>
        <text wx:else class="m9 num">9</text>
      </view>
      <text class="bt" style="color:{{banner.tc}}">{{banner.t}}</text><text class="bs">{{banner.sub}}</text>
      <text class="btap">轻点任意处继续</text>
    </view>
  </view>
  <!-- 暂停 -->
  <view wx:if="{{paused}}" class="pzov" catchtouchmove="noop" catchtap="noop">
    <view class="pzbx">
      <view class="pzic"><view class="pzb"></view><view class="pzb"></view></view>
      <text class="pzt">已暂停</text>
      <text class="pzc num">{{clock}}</text>
      <text class="pzs">计时和限时倒计时已停</text>
      <view class="btn pri pzbtn" bindtap="onUnpause" hover-class="press">继续</view>
    </view>
  </view>
  <time-up show="{{tu}}" desc="{{tuDesc}}" land bind:end="onTuEnd" bind:add="onTuAdd" bind:close="onTuClose"/>
</view>
