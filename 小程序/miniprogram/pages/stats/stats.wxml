<nav-bar title="战绩" large scrolled="{{scrolled}}"/>
<view class="wrap {{ent?'ent':'pre'}}">
  <view class="large rise" style="--i:0"><view><text class="ls">{{demo?'当前包含演示数据 · 可在「我的」里清除':'你的台球履历'}}</text><text class="lt">战绩</text></view></view>
  <view class="seg rise" style="--i:1;margin:0 0 28rpx">
    <view class="thumb" style="width:calc(33.33% - 4rpx);transform:translateX({{segIdx*100}}%)"></view>
    <view class="it {{seg==='all'?'on':''}}" data-s="all" bindtap="setSeg">全部</view>
    <view class="it {{seg==='2'?'on':''}}" data-s="2" bindtap="setSeg">双人</view>
    <view class="it {{seg==='3'?'on':''}}" data-s="3" bindtap="setSeg">三人</view>
  </view>

  <!-- 1. 名片（全部战绩） -->
  <view class="idc rise" style="--i:2;background:{{me.c}};color:{{me.i}}">
    <view class="blob b1"></view><view class="blob b2"></view>
    <view class="idt">
      <view class="av" style="background:{{me.i}};color:{{me.c}};width:96rpx;height:96rpx;font-size:40rpx">{{me.ch}}</view>
      <view class="idm"><text class="idn">{{me.name}}</text><text class="idd">{{card.title.d}}</text></view>
      <view class="badge pop" style="--i:3;color:{{me.c}}">{{card.title.t}}</view>
    </view>
    <view class="kpis"><view class="kp" wx:for="{{card.kpis}}" wx:key="l"><text class="kv num">{{item.v}}</text><text class="kl">{{item.l}}</text></view></view>
  </view>

  <view wx:if="{{empty}}" class="card empty-card rise" style="--i:4">
    <view class="ill"><view class="ball" style="width:96rpx;height:96rpx;left:20rpx;top:40rpx;background:#FF5A5F"></view><view class="ball" style="width:110rpx;height:110rpx;left:70rpx;top:10rpx;background:#FFC53D;animation-delay:-1.2s"></view><view class="ball" style="width:88rpx;height:88rpx;left:140rpx;top:50rpx;background:#3D7BFF;animation-delay:-2.4s"></view></view>
    <text class="ee">还没有战绩</text><text class="es">打完并保存一场对局，这里就会出现你的球风称号、个人数据和球友关系</text>
    <view class="btn pri go-btn" bindtap="start" hover-class="press">去开一局</view>
  </view>

  <view wx:else>
    <!-- 2. 最近场次 + 时间范围（下面所有内容跟着切换） -->
    <view class="sec rise" style="--i:4">最近场次
      <view class="rg">
        <view class="rgi {{days===7?'on':''}}" data-d="7" bindtap="setDays">近7天</view>
        <view class="rgi {{days===30?'on':''}}" data-d="30" bindtap="setDays">近30天</view>
        <view class="rgi {{days===0?'on':''}}" data-d="0" bindtap="setDays">全部</view>
      </view>
    </view>
    <view class="card form rise" style="--i:5">
      <view class="ft">{{rangeTxt}}<text class="fts">左旧右新</text></view>
      <view wx:if="{{rangeEmpty}}" class="fe">这段时间还没有打球</view>
      <view wx:for="{{recent}}" wx:key="k" class="fd {{item.r}}">{{item.r==='W'?'胜':item.r==='L'?'负':'平'}}</view>
    </view>

    <view wx:if="{{!rangeEmpty}}">
      <!-- 3. 战绩概览 -->
      <view class="card wld rise" style="--i:6">
        <view class="wr1"><text class="wrl">胜率</text><text class="wrv num">{{O.wld.rate}}%</text></view>
        <view class="wbar"><view class="wb w" style="flex:{{O.wld.w||0.001}}"></view><view class="wb l" style="flex:{{O.wld.l||0.001}}"></view><view class="wb d" style="flex:{{O.wld.d||0.001}}"></view></view>
        <view class="wpills">
          <view class="wp w"><text class="num">{{O.wld.w}}</text>胜</view>
          <view class="wp l"><text class="num">{{O.wld.l}}</text>负</view>
          <view class="wp d"><text class="num">{{O.wld.d}}</text>平</view>
        </view>
      </view>

      <!-- 4. 净胜分走势 -->
      <view class="sec rise" style="--i:7">净胜分走势<text class="s">每场之后的累计</text></view>
      <view class="card rise" style="--i:8;padding:20rpx 16rpx">
        <trend-chart series="{{O.chart.series}}" colors="{{O.chart.colors}}" names="{{O.chart.names}}" titles="{{O.chart.titles}}" notes="{{O.chart.notes}}" ticks="{{O.chart.ticks}}" fill="{{true}}" height="{{340}}"/>
      </view>

      <!-- 5. 个人数据 -->
      <view class="sec rise" style="--i:9">个人数据<text class="s">共 {{O.P.n}} 场</text></view>
      <view class="card grid rise" style="--i:10">
        <view wx:for="{{O.grid}}" wx:key="l" class="gc {{item.hot?'hot':''}}">
          <text class="gl">{{item.l}}</text>
          <text class="gv num {{item.cls||''}}" style="{{item.c?'color:'+item.c:''}}">{{item.v}}</text>
        </view>
      </view>

      <!-- 6. 得分来源 -->
      <view wx:if="{{O.sources.length}}" class="sec rise" style="--i:10">得分来源<text class="s">赢来的 {{O.gainTotal}} 分</text></view>
      <view wx:if="{{O.sources.length}}" class="card src rise" style="--i:10">
        <view class="sbar"><view wx:for="{{O.sources}}" wx:key="k" class="sb" style="flex:{{item.v}};background:{{item.c}}"></view></view>
        <view class="sl"><view wx:for="{{O.sources}}" wx:key="k" class="sli"><view class="sd" style="background:{{item.c}}"></view><text>{{item.l}}</text><text class="num slv">{{item.w}}%</text></view></view>
      </view>
    </view>

    <!-- 7. 成就（全部战绩） -->
    <view class="sec rise" style="--i:10">成就<text class="s">已解锁 {{ach.got}} / {{ach.list.length}}</text></view>
    <view class="card ach rise" style="--i:10">
      <view wx:for="{{ach.list}}" wx:key="k" class="ac {{item.ok?'ok':''}}">
        <view class="aci" style="{{item.ok?'background:'+item.c+';box-shadow:0 10rpx 24rpx -10rpx '+item.c:''}}">{{item.ic}}</view>
        <text class="act">{{item.t}}</text>
        <text class="acd">{{item.ok?item.d:item.p}}</text>
      </view>
    </view>

    <view wx:if="{{!rangeEmpty}}">
      <!-- 8. 球友关系 -->
      <view class="sec rise" style="--i:10">球友关系<text class="s">{{friends.length}} 位 · 点击看交手</text></view>
      <view class="card rise" style="--i:10">
        <view class="row {{index>0?'sep':''}}" wx:for="{{friends}}" wx:key="id" data-id="{{item.id}}" bindtap="toH2h" hover-class="rowp">
          <view class="av" style="background:{{item.c}};color:{{item.i}}">{{item.ch}}</view>
          <view class="hm"><view class="hn">vs {{item.name}}<text wx:if="{{item.tag==='bank'}}" class="rtag" style="background:#1FC98E">提款机</text><text wx:if="{{item.tag==='nem'}}" class="rtag" style="background:#F0444D">克星</text></view><text class="hs">同场 {{item.n}} 次 · 交锋 {{item.netTxt}}</text></view>
          <view class="wlb"><text class="num"><text style="color:#13B57A">{{item.w}}</text> : <text style="color:#F0444D">{{item.l}}</text></text><view class="mini"><view style="width:{{item.rate}}%"></view></view></view>
          <text class="chev">›</text>
        </view>
      </view>

      <!-- 9. 历史对局 -->
      <view class="sec rise" style="--i:10">历史对局<text class="s">左滑可删除</text></view>
      <view class="hist rise" style="--i:10">
        <view class="hc-wrap" wx:for="{{rows}}" wx:key="id">
          <swipe-row data-id="{{item.id}}" bind:tapbody="open" bind:delete="askDelete">
            <view class="hc {{item.resK}}">
              <view class="hct">
                <view class="mode-ic m{{item.mode==='双人'?2:3}}">{{item.mode==='双人'?'2':'3'}}</view>
                <text class="hcm">{{item.mode}}追分</text><text class="hcd">{{item.full}} · {{item.rounds}} 局</text>
                <text class="res {{item.resK}}">{{item.resK==='W'?'胜利':item.resK==='L'?'失败':'平局'}}</text>
              </view>
              <view class="chips2">
                <view wx:for="{{item.chips}}" wx:for-item="p" wx:key="id" class="pchip {{p.cls}}">
                  <text wx:if="{{p.me}}" class="metag">我</text><text class="pn">{{p.name}}</text><text class="ps num">{{p.s}}</text>
                </view>
              </view>
            </view>
          </swipe-row>
        </view>
      </view>
    </view>
  </view>
  <view class="tabpad"></view>
</view>
<ui-sheet show="{{ui.show}}" icon="{{ui.icon}}" title="{{ui.title}}" desc="{{ui.desc}}" actions="{{ui.actions}}" bind:action="onUi" bind:close="onUiClose"/>
